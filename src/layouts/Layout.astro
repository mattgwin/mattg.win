---
import { siteConfig } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Emit Article JSON-LD instead of the site-wide Person schema. */
  article?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  article = false,
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} - ${siteConfig.name}`
  : `${siteConfig.name} - ${siteConfig.title}`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;

// sameAs is what links this domain to the LinkedIn/GitHub profiles as one
// entity, so it stays even when the rest of the schema is trimmed.
const schema = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description,
      url: canonical,
      image: ogImage,
      author: {
        "@type": "Person",
        name: siteConfig.name,
        url: Astro.site?.href,
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "Person",
      name: siteConfig.name,
      jobTitle: siteConfig.title,
      description: siteConfig.aboutMe,
      url: Astro.site?.href,
      image: ogImage,
      email: `mailto:${siteConfig.social.email}`,
      address: {
        "@type": "PostalAddress",
        addressLocality: siteConfig.location,
      },
      knowsAbout: siteConfig.skills,
      sameAs: [siteConfig.social.linkedin, siteConfig.social.github],
    };
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
