---
import { getCollection } from "astro:content";
import { siteConfig } from "../config";
import { asset } from "../utils/asset";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const hasProjects = projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Projects
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-4 sm:space-y-6">
              {projects.map((project) => (
                <div class="group relative">
                  <a
                    href={asset(`/projects/${project.id}/`)}
                    class="flex items-center gap-5 sm:gap-6 relative p-5 sm:p-6 md:p-7 pr-16 sm:pr-20 md:pr-24 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 hover:bg-gray-100 hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
                  >
                    {/* Real logo where the project has one, initials otherwise. */}
                    {project.data.logo ? (
                      <img
                        src={asset(project.data.logo)}
                        alt=""
                        loading="lazy"
                        class="shrink-0 h-14 w-14 sm:h-16 sm:w-16 object-contain"
                      />
                    ) : (
                      <span
                        aria-hidden="true"
                        class="shrink-0 h-14 w-14 sm:h-16 sm:w-16 rounded-full border-2 flex items-center justify-center text-base sm:text-lg font-bold tracking-tight"
                        style={`border-color: ${siteConfig.accentColor}; color: ${siteConfig.accentColor}`}
                      >
                        {project.data.monogram ?? project.data.name.charAt(0)}
                      </span>
                    )}

                    <div class="min-w-0">
                      <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-gray-900 leading-tight">
                        {project.data.name}
                      </h3>
                      <p class="mt-1.5 text-sm sm:text-base text-gray-600 leading-relaxed">
                        {project.data.tagline}
                      </p>
                    </div>

                    <div class="absolute top-1/2 -translate-y-1/2 right-5 sm:right-6 md:right-7 w-10 h-10 sm:w-11 sm:h-11 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                      <svg
                        class="w-4 h-4 sm:w-5 sm:h-5 transition-transform duration-300 group-hover:translate-x-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M5 12h14M13 6l6 6-6 6"
                        />
                      </svg>
                    </div>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
